{
  "name": "wretched-wavelength",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "KEYSTATIC=true astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "hooks:install": "git config core.hooksPath .githooks",
    "journal-club:slug-date:check": "node scripts/prefix-journal-club-date-slugs.mjs",
