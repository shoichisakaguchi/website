---
import { getCollection } from "astro:content";
import { formatDate } from "../utils/date";
import TypeBadge from "./TypeBadge.astro";
import { sortEntriesByDateDesc } from "../utils/sortDate";

// Fetch posts (unified announcements + posts)
const allPosts = await getCollection("posts");

// Sort by date descending
const sortedPosts = sortEntriesByDateDesc(allPosts, "posts");

// Take latest 3
const latestPosts = sortedPosts.slice(0, 3);

---

{
    latestPosts.length > 0 && (
        <section class="announcements-section">
            <h2 class="section-title">Latest Posts</h2>
            <div class="announcements-list">
                {latestPosts.map((item) => (
                    <article class="announcement-card">
                        <a
                            href={`/posts/${item.slug}`}
                            class="card-link"
                        >
                            <div class="content">
                                <div class="meta">
                                    <span class="date">
                                        {formatDate(item.data.publishedDate)}
                                    </span>
                                    <TypeBadge type={item.data.type} />
                                </div>
                                <h3 class="title">{item.data.title}</h3>
                            </div>
                        </a>
                    </article>
                ))}
            </div>
            <div class="view-all-container">
                <a href="/posts" class="view-all-link">
                    View all updates &rarr;
                </a>
            </div>
        </section>
    )
}

<style>
    .announcements-section {
        margin-bottom: 60px;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
        padding: 0 20px;
    }

    .section-title {
        text-align: center;
        margin-bottom: 1rem;
        font-size: 2rem;
        line-height: 1.2;
        font-weight: 700;
        color: var(--c-text);
    }

    .announcements-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .announcement-card {
        background: white;
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 8px;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            border-color 0.2s ease;
    }

    .announcement-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
        border-color: rgba(0, 0, 0, 0.1);
    }

    .card-link {
        display: block;
        padding: 16px;
        text-decoration: none;
        color: inherit;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .content {
        flex: 1;
    }

    .meta {
        font-size: 13px;
        color: #666;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .title {
        margin: 0;
        font-size: 16px;
        font-weight: 600;
        line-height: 1.4;
        color: var(--c-text);
    }

    .view-all-container {
        text-align: center;
        margin-top: 20px;
    }

    .view-all-link {
        font-size: 14px;
        font-weight: 500;
        color: var(--c-link);
        text-decoration: none;
    }
    .view-all-link:hover {
        text-decoration: underline;
    }
</style>
