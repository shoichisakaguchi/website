---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../utils/date";
import { marked } from "marked";
import { sortEntriesByDateDesc } from "../../utils/sortDate";
import TypeBadge from "../../components/TypeBadge.astro";

export const prerender = true;

const posts = await getCollection("posts");
const sortedPosts = sortEntriesByDateDesc(posts, "posts");
const postsWithExcerpt = sortedPosts.map((item) => ({
	item,
	excerptHtml: item.data.excerpt?.trim()
		? marked.parse(item.data.excerpt)
		: null,
}));

---

<Layout>
	<div class="container page-content">
		<h1 class="page-title">Posts</h1>
		<div class="content-wrapper">
			<ul class="post-list">
				{
					postsWithExcerpt.map(({ item, excerptHtml }) => (
						<li>
							<div class="meta">
								<span class="date">
									{formatDate(item.data.publishedDate)}
								</span>
								<TypeBadge type={item.data.type} />
							</div>
							<a
								href={`/posts/${item.slug}`}
								class="title"
							>
								{item.data.title}
							</a>
							{excerptHtml && (
								<div class="excerpt" set:html={excerptHtml} />
							)}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</Layout>

<style>
	.page-content {
		max-width: 720px;
		margin: 0 auto;
	}

	.page-title {
		margin-top: var(--space-page-title-top);
		margin-bottom: var(--space-page-title-bottom);
		text-align: center;
	}

	.post-list {
		list-style: none;
		padding: 0;
	}

	.post-list li {
		padding: 20px 0;
		border-bottom: 1px solid var(--c-divider, #eee);
	}

	.post-list li:last-child {
		border-bottom: none;
	}

	.meta {
		font-size: var(--fs-meta);
		color: var(--c-text-light, #666);
		margin-bottom: 4px;
		display: flex;
		gap: 10px;
		align-items: center;
	}

	.title {
		text-decoration: none;
		color: var(--c-text, #333);
		font-size: calc(var(--fs-body) * 1.2);
		font-weight: var(--fw-semibold);
		display: block;
	}

	.title:hover {
		color: var(--c-link, #0070f3);
	}

	.excerpt {
		margin-top: 8px;
		margin-bottom: 0;
		color: var(--c-text-light, #666);
		font-size: var(--fs-meta);
		line-height: 1.5;
	}

	.excerpt :global(p) {
		margin: 0;
	}
</style>
