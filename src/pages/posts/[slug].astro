---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../utils/date";
import CommunityFooter from "../../components/CommunityFooter.astro";
import TypeBadge from "../../components/TypeBadge.astro";
import PrevNextNav from "../../components/PrevNextNav.astro";
import { marked } from "marked";
import { resolveDescription, resolveOgImage } from "../../lib/og";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedPosts = [...posts].sort(
    (a, b) => a.data.publishedDate.getTime() - b.data.publishedDate.getTime(),
  );

  const toNavItem = (entry?: (typeof sortedPosts)[number]) =>
    entry
      ? {
          slug: entry.slug,
          title: entry.data.title,
          date: entry.data.publishedDate,
        }
      : undefined;

  return sortedPosts.map((item, index) => ({
    params: { slug: item.slug },
    props: {
      item,
      prev: toNavItem(sortedPosts[index - 1]),
      next: toNavItem(sortedPosts[index + 1]),
    },
  }));
}

const { item, prev, next } = Astro.props;
const { Content } = await item.render();

const discussionLabel = item.data.discussionLabel || "Open discussion doc";
const hasTags = item.data.tags && item.data.tags.length > 0;
const hasDiscussion = item.data.discussionUrl && item.data.discussionUrl !== "";
const hasCredits = Array.isArray(item.data.credits) && item.data.credits.length > 0;
const creditLabelMap: Record<string, string> = {
  author: "Author",
  summary: "Summary by",
  editor: "Editor",
  translator: "Translator",
  curator: "Curator",
};
const displayCredits = hasCredits
  ? item.data.credits!.map((credit) => ({
      label: creditLabelMap[credit.role] || "Author",
      name: credit.name,
    }))
  : item.data.author
    ? [{ label: "Author", name: item.data.author }]
    : [];
const excerptHtml = item.data.excerpt?.trim()
  ? await marked.parse(item.data.excerpt)
  : null;
const metaDescription = resolveDescription({
  excerpt: item.data.excerpt,
  body: item.body,
});
const ogImage = resolveOgImage({
  image: item.data.ogImage,
  alt: item.data.ogImageAlt,
  category: "posts",
  title: item.data.title,
  description: metaDescription,
  useDynamic: true,
});
---

<Layout
  title={item.data.title}
  description={metaDescription}
  ogImage={ogImage}
  ogType="article"
>
  <div class="container page-content">
    <div class="back-link">
      <a href="/posts">&larr; Back to posts</a>
    </div>
    <header class="post-header">
      <div class="meta">
        <time>{formatDate(item.data.publishedDate)}</time>
        <TypeBadge type={item.data.type} />
      </div>
      <h1 class="page-title">{item.data.title}</h1>
      {excerptHtml && <div class="post-excerpt" set:html={excerptHtml} />}
    </header>
    <div class="content-wrapper">
      <article id="post-content">
        <Content />
      </article>

      <footer class="post-footer">
        {displayCredits.length > 0 && (
          <div class="author">
            {displayCredits.map((credit) => (
              <div class="credit-line">
                <span class="label">{credit.label}:</span> {credit.name}
              </div>
            ))}
          </div>
        )}

        {hasDiscussion && (
          <div class="discussion">
            <h3>Continue the discussion</h3>
            <p>Join the conversation in the open discussion document.</p>
            <a href={item.data.discussionUrl} target="_blank" rel="noopener noreferrer" class="discussion-link">
              {discussionLabel} &rarr;
            </a>
          </div>
        )}

        {hasTags && (
          <div class="tags">
            <span class="label">Tags:</span>
            {item.data.tags!.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </footer>

      <CommunityFooter variant="post" />
      <PrevNextNav basePath="/posts" prev={prev} next={next} />
    </div>
  </div>
</Layout>

<script>
  const article = document.querySelector("#post-content");
  if (article) {
    const links = article.querySelectorAll("a[href]");
    links.forEach((link) => {
      const href = link.getAttribute("href");
      if (!href) return;
      if (href.startsWith("#") || href.startsWith("/")) {
        link.removeAttribute("target");
        link.removeAttribute("rel");
        return;
      }

      try {
        const url = new URL(href, window.location.origin);
        if (url.origin !== window.location.origin) {
          link.setAttribute("target", "_blank");
          link.setAttribute("rel", "noopener noreferrer");
        } else {
          link.removeAttribute("target");
          link.removeAttribute("rel");
        }
      } catch {
        // Ignore invalid URLs
      }
    });
  }
</script>

<style>
  .page-content {
    max-width: 720px;
    margin: 0 auto;
  }

  .page-title {
    margin-top: 10px;
    margin-bottom: 20px;
  }

  .post-header {
    margin-top: 40px;
    margin-bottom: 40px;
    text-align: center;
  }

  .post-excerpt {
    margin-top: 12px;
    font-size: 1.05em;
    color: var(--c-text, #333);
    text-align: left;
  }

  .post-excerpt :global(p) {
    margin: 0;
  }

  .meta {
    color: var(--c-text-light, #666);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
  }

  .content-wrapper {
    font-size: 17px;
    line-height: 1.7;
    color: var(--c-text, #333);
  }

  .back-link {
    margin-top: 40px;
  }

  .back-link a {
    color: var(--c-text-light, #666);
    text-decoration: none;
    font-size: 0.9em;
  }

  .back-link a:hover {
    text-decoration: underline;
  }

  .post-footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--c-divider, #eee);
  }

  .author {
    margin-bottom: 24px;
    font-size: 0.95em;
  }

  .author .label {
    color: var(--c-text-light, #666);
  }

  .credit-line + .credit-line {
    margin-top: 6px;
  }

  .discussion {
    margin-bottom: 24px;
    padding: 20px;
    background: var(--c-bg-secondary, #f9f9f9);
    border-radius: 8px;
  }

  .discussion h3 {
    margin: 0 0 8px 0;
    font-size: 1.1em;
    font-weight: 600;
  }

  .discussion p {
    margin: 0 0 12px 0;
    font-size: 0.9em;
    color: var(--c-text-light, #666);
  }

  .discussion-link {
    display: inline-block;
    color: var(--c-link, #0070f3);
    text-decoration: none;
    font-weight: 500;
  }

  .discussion-link:hover {
    text-decoration: underline;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 0.9em;
  }

  .tags .label {
    color: var(--c-text-light, #666);
  }

  .tag {
    display: inline-block;
    padding: 2px 8px;
    background: var(--c-divider, #eee);
    border-radius: 4px;
    font-size: 0.85em;
    color: var(--c-text-light, #666);
  }

  /* Basic styling for content */
  article :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.75rem;
    line-height: 1.3;
    font-weight: 600;
  }

  article :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.6rem;
    font-size: 1.375rem;
    line-height: 1.35;
    font-weight: 600;
  }

  article :global(p) {
    margin-bottom: 1em;
  }

  article :global(ul),
  article :global(ol) {
    margin-bottom: 1em;
    padding-left: 2em;
  }

  article :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  /* Posts tables: refined, minimal grid, responsive scroll */
  article :global(table) {
    width: 100%;
    max-width: 100%;
    margin: 1.75rem 0;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--table-bg, var(--c-bg, #fff));
    border: 1px solid var(--table-border, var(--c-divider, #e6e6e6));
    border-radius: 10px;
    box-shadow: none;
    overflow-x: auto;
    display: block;
    -webkit-overflow-scrolling: touch;
  }

  article :global(caption) {
    caption-side: top;
    text-align: left;
    padding: 0 0 0.6rem 0.1rem;
    color: var(--c-text-secondary, #6b6b6b);
    font-size: 0.9em;
  }

  article :global(th),
  article :global(td) {
    padding: 14px 16px;
    vertical-align: top;
    text-align: left;
    border-bottom: 1px solid var(--table-border, var(--c-divider, #ececec));
    line-height: 1.6;
    color: var(--table-text, var(--c-text, #1d1d1f));
  }

  article :global(th) {
    background: var(--table-header-bg, var(--c-bg-secondary, #f5f5f7));
    color: var(--table-header-text, var(--c-text, #1d1d1f));
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  article :global(tr:last-child td) {
    border-bottom: none;
  }

  article :global(tbody tr:hover) {
    background: var(--table-row-hover, rgba(0, 0, 0, 0.02));
  }

  article :global(table a) {
    color: var(--table-link, var(--c-link, #0066cc));
    text-decoration: none;
  }

  article :global(table a:hover) {
    color: var(--table-link-hover, var(--c-link-hover, #004499));
    text-decoration: underline;
  }

  @media (prefers-color-scheme: dark) {
    article :global(table) {
      --table-bg: #ffffff;
      --table-border: #e2e2e2;
      --table-text: #1d1d1f;
      --table-header-bg: #f5f5f7;
      --table-header-text: #1d1d1f;
      --table-row-hover: rgba(0, 0, 0, 0.03);
      --table-link: #0066cc;
      --table-link-hover: #004499;
    }

    article :global(table) {
      box-shadow: none;
    }

    article :global(th),
    article :global(td) {
      border-bottom-color: var(--table-border, #2a2a2a);
    }
  }
</style>
