---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { JOURNAL_CLUB_TIMEZONE_DISPLAY } from '../../lib/journalClubTimezones';
import { resolveDescription, resolveOgImage } from '../../lib/og';
import PrevNextNav from '../../components/PrevNextNav.astro';

export const prerender = true;

export async function getStaticPaths() {
  const items = await getCollection('journal-club');
  const sortedItems = [...items].sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

  const toNavItem = (entry?: (typeof sortedItems)[number]) =>
    entry
      ? {
          slug: entry.slug,
          title: entry.data.title,
          date: entry.data.date,
        }
      : undefined;

  return sortedItems.map((item, index) => ({
    params: { slug: item.slug },
    props: {
      item,
      prev: toNavItem(sortedItems[index - 1]),
      next: toNavItem(sortedItems[index + 1]),
    },
  }));
}

const { item, prev, next } = Astro.props;
const { Content } = await item.render();
const { data } = item;

// Helper to get speaker info (structured for two-line display)
function getSpeakerInfo(): { name: string; affiliation: string | null } | null {
    if (data.speakerName) {
        return {
            name: data.speakerName,
            affiliation: data.speakerAffiliation || null,
        };
    }
    // Fallback to legacy field - try to parse "Name (Affiliation)"
    if (data.speaker) {
        const match = data.speaker.match(/^(.+?)\s*\(([^)]+)\)\s*$/);
        if (match) {
            return { name: match[1].trim(), affiliation: match[2].trim() };
        }
        return { name: data.speaker, affiliation: null };
    }
    return null;
}

// Get all links (new format or legacy)
function getAllLinks(): { label: string; url: string; isPrimary: boolean }[] {
    if (data.links && data.links.length > 0) {
        return data.links;
    }
    if (data.paperUrl) {
        return [{ label: 'Paper', url: data.paperUrl, isPrimary: true }];
    }
    return [];
}

const speakerInfo = getSpeakerInfo();
const allLinks = getAllLinks();
const speakerImage = (() => {
    if (!data.speaker_image || !data.speaker_image.trim()) {
        return null;
    }
    const value = data.speaker_image.trim();
    return value.startsWith('/')
        ? value
        : `/images/journal_club/speakers/${value}`;
})();
const chairs = Array.isArray(data.chairs)
    ? data.chairs.filter(chair => chair?.name && chair?.affiliation)
    : [];

function formatChairsLine(): string | null {
    if (chairs.length === 0) {
        return null;
    }
    return chairs
        .map(chair => `${chair.name} (${chair.affiliation})`)
        .join(' · ');
}

// Helper to get UTC datetime from local or existing UTC field
function getStartDateTimeUtc(): string | null {
    // Prefer existing UTC field for backward compatibility
    if (data.startDateTimeUtc && data.startDateTimeUtc.trim()) {
        return data.startDateTimeUtc.trim();
    }

    // Convert from local date/time if available
    if (data.localDate && data.localTime && data.localTime.trim()) {
        const tz = data.eventTz || 'Asia/Tokyo';
        const dateStr = data.localDate.toISOString().split('T')[0]; // YYYY-MM-DD
        const timeStr = data.localTime.trim(); // HH:mm

        try {
            // Technique: Create a "fake" local date, then adjust for timezone offset
            // Based on: https://stackoverflow.com/a/54127122
            const fakeLocalDate = new Date(`${dateStr}T${timeStr}:00`);

            // Get what this date looks like in the target timezone
            const tzDateString = fakeLocalDate.toLocaleString('en-US', { timeZone: tz });
            const tzDate = new Date(tzDateString);

            // Calculate the difference
            const diff = fakeLocalDate.getTime() - tzDate.getTime();

            // Apply the difference to get the correct UTC time
            const correctUTC = new Date(fakeLocalDate.getTime() + diff);
            return correctUTC.toISOString();
        } catch (e) {
            console.error('Failed to convert local time to UTC:', e);
        }
    }

    return null;
}

const effectiveStartDateTimeUtc = getStartDateTimeUtc();
const EVENT_DURATION_MINUTES = 60;

// Timezone display helper
const TIMEZONES = JOURNAL_CLUB_TIMEZONE_DISPLAY;

function formatTimeInTimezone(utcIsoString: string, timezone: string): string {
    try {
        const date = new Date(utcIsoString);
        const formatter = new Intl.DateTimeFormat('en-US', {
            timeZone: timezone,
            weekday: 'short',
            month: 'short',
            day: 'numeric',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            hour12: false,
        });
        return formatter.format(date);
    } catch (e) {
        return 'Invalid date';
    }
}

// Format date for header
function formatHeaderDate(date: Date): string {
    const formatter = new Intl.DateTimeFormat('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
    });
    return formatter.format(date);
}

// Check if event has ended (for auto-hiding Zoom link)
const hasEventEnded = effectiveStartDateTimeUtc
    ? new Date().getTime() > new Date(effectiveStartDateTimeUtc).getTime() + 2 * 60 * 60 * 1000 // Event end = start + 2 hours
    : false;

// Check if calendar link should be shown (event not yet ended)
// Event duration: ~60 minutes (30 min talk + 30 min discussion)
// Fallback: use date field end-of-day if no time metadata available
const isCalendarUpcoming = (() => {
    const now = new Date().getTime();
    if (effectiveStartDateTimeUtc) {
        // Use precise time: event start + 60 minutes
        return now < new Date(effectiveStartDateTimeUtc).getTime() + EVENT_DURATION_MINUTES * 60 * 1000;
    }
    // Fallback: use date field, event considered over at end of that day (23:59:59)
    const eventDate = new Date(data.date);
    const endOfDay = new Date(eventDate);
    endOfDay.setUTCHours(23, 59, 59, 999);
    return now < endOfDay.getTime();
})();

// Build-time past check for Event Times section.
// Event is considered past when (eventStart + duration) < build time.
const isPast = (() => {
    if (!effectiveStartDateTimeUtc) {
        return false;
    }
    const eventEnd = new Date(effectiveStartDateTimeUtc).getTime() + EVENT_DURATION_MINUTES * 60 * 1000;
    return eventEnd < new Date().getTime();
})();

const metaDescription = resolveDescription({
    body: item.body,
    fallback: 'Upcoming RNA Virus Journal Club session.',
});

const ogImage = resolveOgImage({
    image: data.ogImage,
    alt: data.ogImageAlt,
    category: 'journal-club',
    title: item.data.title,
    description: metaDescription,
    useDynamic: true,
});
---

<Layout
    title={item.data.title}
    description={metaDescription}
    ogImage={ogImage}
    ogType="article"
>
	<div class="container page-content">
		<div class="back-link">
			<a href="/journal-club">← Back to Journal Club</a>
		</div>

        {/* A. Header: Date, Title, Speaker */}
        <header class="post-header">
            <div class="meta">
                <time>{formatHeaderDate(item.data.date)}</time>
            </div>
            <h1 class="page-title">{item.data.title}</h1>

            {speakerInfo && (
                <div class="speaker-callout">
                    {speakerImage && (
                        <img
                            src={speakerImage}
                            alt={`${speakerInfo.name}`}
                            class="speaker-callout-image"
                            loading="lazy"
                        />
                    )}
                    <div class="speaker-callout-text">
                        <span class="speaker-name">{speakerInfo.name}</span>
                        {speakerInfo.affiliation && (
                            <span class="speaker-affiliation">{speakerInfo.affiliation}</span>
                        )}
                    </div>
                </div>
            )}

            {formatChairsLine() && (
                <div class="chairs-inline">
                    <span class="chairs-label">Chaired by</span>{' '}
                    <span class="chairs-text">{formatChairsLine()}</span>
                </div>
            )}
        </header>

        {/* B. Actions: Code links, Add to Calendar, Zoom (consolidated) */}
        <div class="actions-section">
            {allLinks.map(link => (
                <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="action-link"
                >
                    {link.label} &nearr;
                </a>
            ))}
            <a
                href="https://forms.gle/oPdeSmmLnQTi8UAB8"
                target="_blank"
                rel="noopener noreferrer"
                class="action-link discussion-link"
            >
                Join Slack
            </a>
            {data.calendarUrl && isCalendarUpcoming && (
                <a
                    href={data.calendarUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="action-button calendar-button"
                >
                    Add to Calendar
                </a>
            )}
            {data.zoomUrl && data.showZoomLink && !hasEventEnded && (
                <a
                    href={data.zoomUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="action-button zoom-button"
                >
                    Join Zoom
                </a>
            )}
            {data.zoomUrl && !data.showZoomLink && !hasEventEnded && (
                <span class="zoom-note">Add to Google Calendar to get the Zoom link.</span>
            )}
        </div>

        {/* C. Main Content */}
		<div class="content-wrapper">
			<article>
				<Content />
			</article>
		</div>

        {/* D. Event Times (reference section - bottom) */}
        {effectiveStartDateTimeUtc && !isPast && (
            <aside class="event-times-section">
                <h3 class="event-times-heading">Event Times</h3>
                <ul class="timezone-list">
                    {TIMEZONES.map(tz => (
                        <li class="timezone-item">
                            <span class="timezone-label">{tz.label}:</span>
                            <span class="timezone-time">{formatTimeInTimezone(effectiveStartDateTimeUtc, tz.name)}</span>
                        </li>
                    ))}
                </ul>
            </aside>
        )}

        <PrevNextNav basePath="/journal-club" prev={prev} next={next} />
	</div>
</Layout>

<style>
	.page-content {
		max-width: 720px;
		margin: 0 auto;
	}

	.page-title {
		margin-top: 10px;
		margin-bottom: 20px;
        text-align: center;
	}
    
    .post-header {
        margin-top: 40px;
        margin-bottom: 32px;
        padding-bottom: 24px;
        border-bottom: 1px solid #e5e7eb;
    }

    .meta {
        color: var(--c-text-light, #666);
        margin-bottom: 10px;
        text-align: center;
        font-size: 0.95em;
    }

    .speaker-callout {
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 20px auto 0;
        padding: 16px 18px;
        background-color: #f6f6f6;
        border-radius: 10px;
    }

    .speaker-callout-image,
    .speaker-callout img {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        flex: 0 0 80px;
    }

    .speaker-callout-text {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .speaker-name {
        display: block;
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--c-text, #333);
    }

    .speaker-affiliation {
        display: block;
        font-size: 0.95em;
        color: var(--c-text-secondary, #666);
    }

    .chairs-inline {
        margin-top: 8px;
        margin-bottom: 8px;
        text-align: center;
        font-size: 0.85em;
        line-height: 1.5;
        color: var(--c-text-secondary, #666);
    }

    .chairs-label {
        font-weight: 500;
    }

    .chairs-text {
        font-weight: 400;
    }

    /* Actions Section (consolidated) */
    .actions-section {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 48px;
        padding: 20px;
        background-color: #f9fafb;
        border-radius: 8px;
        flex-wrap: wrap;
        align-items: center;
    }

    .action-link {
        display: inline-block;
        padding: 8px 16px;
        border: 1px solid var(--c-link, #0070f3);
        border-radius: 6px;
        color: var(--c-link, #0070f3);
        text-decoration: none;
        font-size: 0.9em;
        transition: background-color 0.2s, color 0.2s;
    }

    .action-link:hover {
        background-color: var(--c-link, #0070f3);
        color: white;
        text-decoration: none;
    }

    .action-button {
        display: inline-block;
        padding: 10px 20px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9em;
        transition: opacity 0.2s;
    }

    .action-button:hover {
        opacity: 0.8;
        text-decoration: none;
    }

    .calendar-button {
        background-color: #4285f4;
        color: white;
    }

    .zoom-button {
        background-color: #2d8cff;
        color: white;
    }

    .zoom-note {
        font-size: 0.9em;
        color: var(--c-text-secondary, #666);
        font-style: italic;
    }

	.content-wrapper {
		font-size: 18px;
		line-height: 1.6;
		color: var(--c-text, #333);
        margin-bottom: 60px;
	}

    /* Event Times Section (bottom reference) */
    .event-times-section {
        margin-top: 48px;
        padding: 24px;
        background-color: #f9fafb;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
    }

    .event-times-heading {
        font-size: 1.1em;
        font-weight: 600;
        margin-bottom: 16px;
        margin-top: 0;
        color: var(--c-text-secondary, #666);
    }

    .timezone-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .timezone-item {
        font-size: 0.9em;
        color: var(--c-text, #333);
        padding: 10px 0;
        line-height: 1.6;
        border-bottom: 1px solid #f0f0f0;
    }

    .timezone-item:last-child {
        border-bottom: none;
    }

    .timezone-label {
        font-weight: 500;
        color: var(--c-text-secondary, #666);
        display: inline-block;
        min-width: 200px;
    }

    .timezone-time {
        color: var(--c-text, #333);
        font-variant-numeric: tabular-nums;
    }

	.back-link {
		margin-top: 40px;
	}

	.back-link a {
		color: var(--c-text-light, #666);
		text-decoration: none;
		font-size: 0.9em;
	}

	.back-link a:hover {
		text-decoration: underline;
	}

  /* Basic styling for content */
  article :global(h2) {
    margin-top: 2em;
    font-size: 1.5em;
    font-weight: 600;
  }

  article :global(h3) {
      margin-top: 1.5em;
      font-size: 1.25em;
      font-weight: 600;
  }

  article :global(p) {
    margin-bottom: 1em;
  }

  article :global(ul), article :global(ol) {
    margin-bottom: 1em;
    padding-left: 2em;
  }

  /* Note: Legacy entries may have duplicate sections in body content */
  /* Ideally, these should be cleaned up when editing old entries */
  /* The template prioritizes structured frontmatter data over body content */
</style>
