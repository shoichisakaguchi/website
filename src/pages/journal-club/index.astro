---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { sortEntriesByDateDesc } from "../../utils/sortDate";

export const prerender = true;

import { resolveEventTimes } from "../../lib/journalClubTime.mjs";

const items = await getCollection("journal-club");
const sortedItems = sortEntriesByDateDesc(items, "journal-club");

// Split the schedule into what is still to come and what has happened. The
// build clock decides the initial split; the script at the bottom re-checks it
// with the visitor's clock, so a stale build cannot leave a finished session
// sitting under "Upcoming".
const now = new Date();
const endOf = (item: (typeof sortedItems)[number]) =>
    resolveEventTimes(item.data)?.end ?? null;

const upcomingItems = sortedItems
    .filter((item) => {
        const end = endOf(item);
        return !!end && end > now;
    })
    .reverse(); // soonest first
const pastItems = sortedItems.filter((item) => {
    const end = endOf(item);
    return !end || end <= now;
}); // newest first, as sorted

const endAttr = (item: (typeof sortedItems)[number]) =>
    endOf(item)?.toISOString() ?? undefined;

// Helper to get speaker info (structured for two-line display)
function getSpeakerInfo(data: typeof sortedItems[0]['data']): { name: string; affiliation: string | null } | null {
    // New structured fields
    if (data.speakerName) {
        return {
            name: data.speakerName,
            affiliation: data.speakerAffiliation || null,
        };
    }
    // Fallback to legacy field - try to parse "Name (Affiliation)"
    if (data.speaker) {
        const match = data.speaker.match(/^(.+?)\s*\(([^)]+)\)\s*$/);
        if (match) {
            return { name: match[1].trim(), affiliation: match[2].trim() };
        }
        return { name: data.speaker, affiliation: null };
    }
    return null;
}

// Helper to get primary link
function getPrimaryLink(data: typeof sortedItems[0]['data']): { label: string; url: string } | null {
    // New links array
    if (data.links && data.links.length > 0) {
        const primary = data.links.find(l => l.isPrimary) || data.links[0];
        return { label: primary.label, url: primary.url };
    }
    // Fallback to legacy field
    if (data.paperUrl) {
        return { label: 'Link', url: data.paperUrl };
    }
    return null;
}

// Format date consistently
function formatDate(date: Date): string {
    const formatter = new Intl.DateTimeFormat('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
    });
    return formatter.format(date);
}
---

<Layout>
    <div class="container page-content">
        <h1 class="page-title">RNA Virus Journal Club</h1>

        <div class="intro-section">
            <p class="intro-text">
                The <strong>RNA Virus Journal Club</strong> is a community project
                emerging from the <a href="/">RdRp Summit</a>. Driven by the
                community, it provides a platform to discuss recent papers,
                methods, and ideas related to RNA virus biology, RdRp discovery,
                and computational virology.
            </p>
            <p class="intro-text">
                Announcements and discussions take place on our <strong
                    >Slack</strong
                > channel, and session times are coordinated via our <strong
                    >Google Calendar</strong
                >.
            </p>

            <div class="action-container">
                <a
                    href="https://docs.google.com/forms/d/e/1FAIpQLSdjvzJGh4vtCcq76qP79CW2qniycLix_LMwIfVRdG2bbuuPNg/viewform?usp=dialog"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="nomination-button"
                >
                    Nominate a Speaker
                </a>
                <p class="action-note">
                    Community members are encouraged to nominate themselves or
                    others.
                </p>
            </div>
        </div>

        <div class="journal-list">
            <div class="table-container">
                <table class="journal-table" data-jc-pair>
                    <thead>
                        <tr>
                            <th class="col-date">Date</th>
                            <th class="col-topic">Paper / Topic</th>
                            <th class="col-speaker">Speaker</th>
                            <th class="col-link">Paper</th>
                        </tr>
                    </thead>
                    <tbody data-jc-list="upcoming" hidden={upcomingItems.length === 0}>
                        <tr class="section-row" data-jc-heading>
                            <th colspan="4">Upcoming</th>
                        </tr>
                        {
                            upcomingItems.map((item) => {
                                const speakerInfo = getSpeakerInfo(item.data);
                                const primaryLink = getPrimaryLink(item.data);
                                return (
                                    <tr data-jc-row data-jc-end={endAttr(item)}>
                                        <td class="col-date">
                                            {formatDate(item.data.date)}
                                        </td>
                                        <td class="col-topic">
                                            <a
                                                href={`/journal-club/${item.slug}`}
                                                class="topic-link"
                                            >
                                                {item.data.title}
                                            </a>
                                        </td>
                                        <td class="col-speaker">
                                            {speakerInfo ? (
                                                <div class="speaker-cell">
                                                    <span class="speaker-name">{speakerInfo.name}</span>
                                                    {speakerInfo.affiliation && (
                                                        <span class="speaker-affiliation">{speakerInfo.affiliation}</span>
                                                    )}
                                                </div>
                                            ) : (
                                                "-"
                                            )}
                                        </td>
                                        <td class="col-link">
                                            {primaryLink ? (
                                                <a
                                                    href={primaryLink.url}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="paper-link"
                                                >
                                                    {primaryLink.label} &nearr;
                                                </a>
                                            ) : (
                                                "-"
                                            )}
                                        </td>
                                    </tr>
                                );
                            })
                        }
                    </tbody>
                    <tbody data-jc-list="past">
                        <tr class="section-row" data-jc-heading>
                            <th colspan="4">Past sessions</th>
                        </tr>
                        {
                            pastItems.map((item) => {
                                const speakerInfo = getSpeakerInfo(item.data);
                                const primaryLink = getPrimaryLink(item.data);
                                return (
                                    <tr data-jc-row data-jc-end={endAttr(item)}>
                                        <td class="col-date">
                                            {formatDate(item.data.date)}
                                        </td>
                                        <td class="col-topic">
                                            <a
                                                href={`/journal-club/${item.slug}`}
                                                class="topic-link"
                                            >
                                                {item.data.title}
                                            </a>
                                        </td>
                                        <td class="col-speaker">
                                            {speakerInfo ? (
                                                <div class="speaker-cell">
                                                    <span class="speaker-name">{speakerInfo.name}</span>
                                                    {speakerInfo.affiliation && (
                                                        <span class="speaker-affiliation">{speakerInfo.affiliation}</span>
                                                    )}
                                                </div>
                                            ) : (
                                                "-"
                                            )}
                                        </td>
                                        <td class="col-link">
                                            {primaryLink ? (
                                                <a
                                                    href={primaryLink.url}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="paper-link"
                                                >
                                                    {primaryLink.label} &nearr;
                                                </a>
                                            ) : (
                                                "-"
                                            )}
                                        </td>
                                    </tr>
                                );
                            })
                        }
                    </tbody>
                </table>
            </div>

            <div class="journal-list-mobile" data-jc-pair>
                <div class="journal-group" data-jc-list="upcoming" hidden={upcomingItems.length === 0}>
                    <h2 class="section-heading" data-jc-heading>Upcoming</h2>
                    {
                        upcomingItems.map((item) => {
                        const speakerInfo = getSpeakerInfo(item.data);
                        const primaryLink = getPrimaryLink(item.data);
                        return (
                            <div class="journal-item" data-jc-row data-jc-end={endAttr(item)}>
                                <div class="item-date">
                                    {formatDate(item.data.date)}
                                </div>
                                <h3 class="item-title">
                                    <a href={`/journal-club/${item.slug}`}>
                                        {item.data.title}
                                    </a>
                                </h3>
                                {speakerInfo && (
                                    <div class="item-speaker">
                                        <span class="speaker-name">{speakerInfo.name}</span>
                                        {speakerInfo.affiliation && (
                                            <span class="speaker-affiliation">{speakerInfo.affiliation}</span>
                                        )}
                                    </div>
                                )}
                                {primaryLink && (
                                    <a
                                        href={primaryLink.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="item-paper-link"
                                    >
                                        {primaryLink.label} &nearr;
                                    </a>
                                )}
                            </div>
                        );
                    })
                    }
                </div>
                <div class="journal-group" data-jc-list="past">
                    <h2 class="section-heading" data-jc-heading>Past sessions</h2>
                    {
                        pastItems.map((item) => {
                        const speakerInfo = getSpeakerInfo(item.data);
                        const primaryLink = getPrimaryLink(item.data);
                        return (
                            <div class="journal-item" data-jc-row data-jc-end={endAttr(item)}>
                                <div class="item-date">
                                    {formatDate(item.data.date)}
                                </div>
                                <h3 class="item-title">
                                    <a href={`/journal-club/${item.slug}`}>
                                        {item.data.title}
                                    </a>
                                </h3>
                                {speakerInfo && (
                                    <div class="item-speaker">
                                        <span class="speaker-name">{speakerInfo.name}</span>
                                        {speakerInfo.affiliation && (
                                            <span class="speaker-affiliation">{speakerInfo.affiliation}</span>
                                        )}
                                    </div>
                                )}
                                {primaryLink && (
                                    <a
                                        href={primaryLink.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="item-paper-link"
                                    >
                                        {primaryLink.label} &nearr;
                                    </a>
                                )}
                            </div>
                        );
                    })
                    }
                </div>
            </div>
        </div>
    </div>

<script is:inline>
    // Re-check the Upcoming / Past split against the visitor's clock. The page
    // is prerendered, so without this a session that has already happened would
    // stay under "Upcoming" until the next build.
    (() => {
        document.querySelectorAll("[data-jc-pair]").forEach((pair) => {
            const upcoming = pair.querySelector('[data-jc-list="upcoming"]');
            const past = pair.querySelector('[data-jc-list="past"]');
            if (!upcoming || !past) return;

            const rows = (el) => Array.from(el.querySelectorAll("[data-jc-row]"));

            const settle = () => {
                const now = Date.now();
                const heading = past.querySelector("[data-jc-heading]");
                // Upcoming is soonest-first; inserting each ended row directly
                // after the Past heading leaves Past newest-first.
                rows(upcoming)
                    .filter((row) => {
                        const end = row.getAttribute("data-jc-end");
                        return end && Date.parse(end) <= now;
                    })
                    .forEach((row) => {
                        if (heading && heading.nextSibling) {
                            past.insertBefore(row, heading.nextSibling);
                        } else {
                            past.insertBefore(row, past.firstChild);
                        }
                    });

                [upcoming, past].forEach((group) => {
                    const empty = rows(group).length === 0;
                    group.hidden = empty;
                    const h = group.querySelector("[data-jc-heading]");
                    if (h) h.hidden = empty;
                });
            };

            settle();
            setInterval(settle, 60000);
        });
    })();
</script>
</Layout>

<style>
    /* Author rules like .button { display: inline-flex } outbid the UA's
       [hidden] { display: none }, so the toggles above need this to bite. */
    [hidden] {
        display: none !important;
    }


    .section-row th {
        padding-top: 28px;
        font-size: 13px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #86868b;
        text-align: left;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }

    .journal-group .section-heading {
        margin: 28px 0 12px;
        font-size: 13px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #86868b;
        font-weight: 600;
    }

    .page-content {
        max-width: 980px;
        margin: 0 auto;
    }

    .page-title {
        margin-top: var(--space-page-title-top);
        margin-bottom: var(--space-page-title-bottom);
        text-align: center;
    }

    .intro-section {
        max-width: 700px;
        margin: 0 auto var(--space-section);
        text-align: center;
    }

    .intro-text {
        font-size: var(--fs-intro);
        line-height: 1.5;
        color: var(--c-text);
        margin-bottom: 1em;
    }

    .action-container {
        margin-top: var(--space-section-tight);
    }

    .nomination-button {
        display: inline-block;
        padding: 10px 24px;
        background-color: var(--c-link);
        color: white;
        text-decoration: none;
        border-radius: 999px;
        font-weight: var(--fw-semibold);
        transition: opacity 0.2s;
    }

    .nomination-button:hover {
        opacity: 0.8;
        text-decoration: none;
        color: white;
    }

    .action-note {
        margin-top: 12px;
        font-size: var(--fs-meta);
        color: var(--c-text-secondary);
    }

    /* Table Styles (Desktop) */
    .table-container {
        display: none;
    }

    @media (min-width: 768px) {
        .table-container {
            display: block;
        }
        .journal-list-mobile {
            display: none;
        }
    }

    .journal-table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--fs-body);
    }

    .journal-table th,
    .journal-table td {
        padding: 12px 15px;
        text-align: left;
        border-bottom: 1px solid var(--c-divider, #eee);
    }

    .journal-table th {
        font-weight: 600;
        color: var(--c-text-secondary, #666);
        border-bottom: 2px solid var(--c-divider, #eee);
    }

    .col-date {
        white-space: nowrap;
        width: 120px;
    }
    .col-speaker {
        width: 180px;
    }
    .col-link {
        width: 100px;
        text-align: right !important;
    }

    .speaker-cell {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .speaker-cell .speaker-name {
        font-weight: var(--fw-semibold);
        color: var(--c-text, #333);
    }

    .speaker-cell .speaker-affiliation {
        font-size: var(--fs-small);
        color: var(--c-text-secondary, #666);
    }

    .topic-link {
        font-weight: var(--fw-semibold);
        color: var(--c-text, #333);
        text-decoration: none;
    }

    .topic-link:hover {
        color: var(--c-link, #0070f3);
        text-decoration: underline;
    }

    .paper-link {
        color: var(--c-link, #0070f3);
        text-decoration: none;
        font-size: var(--fs-meta);
    }

    .paper-link:hover {
        text-decoration: underline;
    }

    /* Mobile List Styles */
    .journal-item {
        margin-bottom: 24px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--c-divider, #eee);
    }

    .item-date {
        font-size: var(--fs-meta);
        color: var(--c-text-secondary, #666);
        margin-bottom: 4px;
    }

    .item-title {
        margin: 0 0 8px;
        font-size: var(--fs-intro);
    }

    .item-title a {
        color: var(--c-text, #333);
        text-decoration: none;
    }

    .item-speaker {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-bottom: 8px;
    }

    .item-speaker .speaker-name {
        font-size: var(--fs-meta);
        font-weight: var(--fw-semibold);
        color: var(--c-text, #333);
    }

    .item-speaker .speaker-affiliation {
        font-size: var(--fs-small);
        color: var(--c-text-secondary, #666);
    }

    .item-paper-link {
        color: var(--c-link, #0070f3);
        text-decoration: none;
        font-size: var(--fs-meta);
    }
</style>
