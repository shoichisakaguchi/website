# ---------------------------------------------------------------------------
# Copy to .env for local development. Never commit .env (it is gitignored).
# In production these are set as Cloudflare Pages environment variables.
# ---------------------------------------------------------------------------

# Resend API key, used by the contact form (src/pages/api/contact.ts).
RESEND_API_KEY=re_123456789_dummy_value

# Where contact form submissions are delivered.
# Optional — defaults to shoichi.sakaguchi@gmail.com when unset.
CONTACT_EMAIL=info@rdrp.io

# Keystatic GitHub mode (production only; local dev uses kind: "local" and
# needs none of these). Create these under the GitHub App backing /keystatic.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
